{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Yarp": "Information"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "flight": {
                "ClusterId": "flight",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger": {
                "ClusterId": "passenger",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "booking": {
                "ClusterId": "booking",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            },
            "identity-api": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "identity-connect": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "identity-discovery": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "flight": {
                "Destinations": {
                    "default": {
                        "Address": "https://localhost:5200"
                    }
                }
            },
            "passenger": {
                "Destinations": {
                    "default": {
                        "Address": "https://localhost:5300"
                    }
                }
            },
            "booking": {
                "Destinations": {
                    "default": {
                        "Address": "https://localhost:5400"
                    }
                }
            },
            "identity": {
                "Destinations": {
                    "default": {
                        "Address": "https://localhost:5100"
                    }
                }
            }
        }
    }
}
