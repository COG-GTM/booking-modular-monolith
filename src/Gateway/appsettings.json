{
  "Jwt": {
    "Authority": "http://localhost:5101",
    "Audience": "booking-modular-monolith"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ObservabilityOptions": {
    "InstrumentationName": "gateway",
    "ServiceName": "gateway",
    "UseOTLPExporter": true,
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317"
    },
    "UseAspireOTLPExporter": false,
    "UsePrometheusExporter": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }],
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v{version}/identity/{**remainder}"
        }
      },
      "flight": {
        "ClusterId": "flight",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v{version}/flight/{**remainder}"
        }
      },
      "passenger": {
        "ClusterId": "passenger",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v{version}/passenger/{**remainder}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v{version}/booking/{**remainder}"
        }
      },
      "connect": {
        "ClusterId": "identity",
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }],
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/connect/{**remainder}"
        }
      },
      "discovery": {
        "ClusterId": "identity",
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }],
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/.well-known/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "flight": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "passenger": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "booking": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104/"
          }
        }
      }
    }
  }
}
