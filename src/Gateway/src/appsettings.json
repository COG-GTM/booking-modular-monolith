{
    "AppOptions": {
        "Name": "Booking-Gateway"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Information"
        }
    },
    "Jwt": {
        "Authority": "http://localhost:5000",
        "Audience": "booking-modular-monolith",
        "MetadataAddress": "http://localhost:5103/.well-known/openid-configuration"
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:4200",
            "http://localhost:5000"
        ]
    },
    "RateLimiting": {
        "Enabled": true,
        "PermitLimit": 100,
        "WindowSeconds": 10,
        "QueueLimit": 0
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_gateway",
        "OTLPOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "booking-gateway"
    },
    "ReverseProxy": {
        "Routes": {
            "identity-api": {
                "ClusterId": "identity",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "flight-api": {
                "ClusterId": "flight",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-api": {
                "ClusterId": "passenger",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "booking-api": {
                "ClusterId": "booking",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            },
            "flight-api-root": {
                "ClusterId": "flight",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/flight"
                }
            },
            "booking-api-root": {
                "ClusterId": "booking",
                "AuthorizationPolicy": "ApiScope",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/api/{version}/booking"
                }
            },
            "identity-connect": {
                "ClusterId": "identity",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                },
                "Transforms": [
                    {
                        "RequestHeaderOriginalHost": "true"
                    }
                ]
            },
            "identity-discovery": {
                "ClusterId": "identity",
                "RateLimiterPolicy": "gateway",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                },
                "Transforms": [
                    {
                        "RequestHeaderOriginalHost": "true"
                    }
                ]
            }
        },
        "Clusters": {
            "identity": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5103/"
                    }
                }
            },
            "flight": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5107/"
                    }
                }
            },
            "passenger": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5102/"
                    }
                }
            },
            "booking": {
                "Destinations": {
                    "primary": {
                        "Address": "http://localhost:5004/"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
