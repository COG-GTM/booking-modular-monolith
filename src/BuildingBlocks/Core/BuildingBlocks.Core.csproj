<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Core DDD/CQRS/event abstractions (IEvent, IDomainEvent, IEventDispatcher, IEventMapper, aggregates), exceptions, utils, MediatR behaviors.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageReference Include="EasyCaching.Core" Version="1.9.2" />
    <PackageReference Include="Google.Protobuf" Version="3.33.5" />
    <PackageReference Include="MassTransit" Version="8.5.8" />
    <PackageReference Include="MediatR" Version="14.0.0" />
    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="Sieve" Version="2.5.5" />
    <PackageReference Include="System.Linq.Async" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Caching\**\*.cs" Link="Caching\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Constants\**\*.cs" Link="Constants\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Exception\**\*.cs" Exclude="..\Exception\GrpcExceptionInterceptor.cs;..\Exception\ProblemDetailsWithCode.cs" Link="Exception\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Logging\**\*.cs" Link="Logging\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Polly\**\*.cs" Link="Polly\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Utils\**\*.cs" Link="Utils\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\Contracts.Messages\Contracts.Messages.csproj" />
  </ItemGroup>
</Project>
