<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\BuildingBlocks.Core.csproj" />
    <ProjectReference Include="..\..\HealthCheck\BuildingBlocks.HealthCheck.csproj" />
    <ProjectReference Include="..\..\Jwt\BuildingBlocks.Jwt.csproj" />
    <ProjectReference Include="..\..\OpenTelemetryCollector\BuildingBlocks.OpenTelemetryCollector.csproj" />
    <ProjectReference Include="..\..\PersistMessageProcessor\BuildingBlocks.PersistMessageProcessor.csproj" />
    <ProjectReference Include="..\..\ProblemDetails\BuildingBlocks.ProblemDetails.csproj" />
    <ProjectReference Include="..\..\Validation\BuildingBlocks.Validation.csproj" />
    <ProjectReference Include="..\..\Web\BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- Coverlet (Cecil) resolves referenced assemblies from the module's directory only.
       BuildingBlocks.* assemblies that live on Microsoft.AspNetCore.App reference framework-only
       assemblies that are never copied to bin, so instrumentation fails with
       CecilAssemblyResolutionException. Copying the shared framework assemblies into the
       output folder lets coverlet resolve them; deps.json still loads them from the shared
       framework at runtime, so this does not change what executes. -->
  <Target Name="CopySharedFrameworkAssembliesForCoverlet" AfterTargets="Build">
    <ItemGroup>
      <_SharedFrameworkAssemblies
        Include="$(HOME)/.dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;$(USERPROFILE)/.dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;$(ProgramFiles)/dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;/usr/share/dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;/usr/lib/dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;/usr/local/share/dotnet/shared/Microsoft.AspNetCore.App/*/*.dll;$(HOME)/.dotnet/shared/Microsoft.NETCore.App/*/*.dll;/usr/share/dotnet/shared/Microsoft.NETCore.App/*/*.dll;/usr/lib/dotnet/shared/Microsoft.NETCore.App/*/*.dll;/usr/local/share/dotnet/shared/Microsoft.NETCore.App/*/*.dll" />
    </ItemGroup>
    <Message Importance="High" Text="Coverlet shared-framework copy: @(_SharedFrameworkAssemblies->Count()) assemblies" />
    <Copy SourceFiles="@(_SharedFrameworkAssemblies)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
