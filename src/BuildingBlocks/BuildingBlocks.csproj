<Project Sdk="Microsoft.NET.Sdk">
  <!-- Thin transition aggregate: no code of its own. It references every BuildingBlocks.* library (plus the
       host-level packages the monolith used to get transitively) so existing consumers keep building.
       New services should reference only the focused BuildingBlocks.<Area> projects/packages they need. -->
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageId>BookingModularMonolith.BuildingBlocks</PackageId>
    <Description>Transition aggregate of all BookingModularMonolith.BuildingBlocks.* libraries.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Constants\BuildingBlocks.Constants.csproj" />
    <ProjectReference Include="Utils\BuildingBlocks.Utils.csproj" />
    <ProjectReference Include="Exception\BuildingBlocks.Exception.csproj" />
    <ProjectReference Include="Core\BuildingBlocks.Core.csproj" />
    <ProjectReference Include="Logging\BuildingBlocks.Logging.csproj" />
    <ProjectReference Include="Caching\BuildingBlocks.Caching.csproj" />
    <ProjectReference Include="Polly\BuildingBlocks.Polly.csproj" />
    <ProjectReference Include="Mapster\BuildingBlocks.Mapster.csproj" />
    <ProjectReference Include="Web\BuildingBlocks.Web.csproj" />
    <ProjectReference Include="Validation\BuildingBlocks.Validation.csproj" />
    <ProjectReference Include="ProblemDetails\BuildingBlocks.ProblemDetails.csproj" />
    <ProjectReference Include="OpenApi\BuildingBlocks.OpenApi.csproj" />
    <ProjectReference Include="Jwt\BuildingBlocks.Jwt.csproj" />
    <ProjectReference Include="EFCore\BuildingBlocks.EFCore.csproj" />
    <ProjectReference Include="PersistMessageProcessor\BuildingBlocks.PersistMessageProcessor.csproj" />
    <ProjectReference Include="Mongo\BuildingBlocks.Mongo.csproj" />
    <ProjectReference Include="EventStoreDB\BuildingBlocks.EventStoreDB.csproj" />
    <ProjectReference Include="MassTransit\BuildingBlocks.MassTransit.csproj" />
    <ProjectReference Include="HealthCheck\BuildingBlocks.HealthCheck.csproj" />
    <ProjectReference Include="OpenTelemetryCollector\BuildingBlocks.OpenTelemetryCollector.csproj" />
    <ProjectReference Include="TestBase\BuildingBlocks.TestBase.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Figgle.Fonts" Version="0.6.5" />
    <PackageReference Include="Grpc.Core.Testing" Version="2.46.6" />
    <PackageReference Include="EasyCaching.InMemory" Version="1.9.2" />
    <PackageReference Include="Figgle" Version="0.6.5" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.3.0" />
    <PackageReference Include="IdGen" Version="3.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.3" />
    <PackageReference Include="Duende.IdentityServer" Version="7.4.6" />
    <PackageReference Include="Duende.IdentityServer.AspNetIdentity" Version="7.4.6" />
    <PackageReference Include="Duende.IdentityServer.EntityFramework" Version="7.4.6" />
    <PackageReference Include="Duende.IdentityServer.EntityFramework.Storage" Version="7.4.6" />
    <PackageReference
      Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"
      Version="10.0.3"
    />
    <PackageReference Include="System.Linq.Async.Queryable" Version="7.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="..\Contracts\Contracts.Messages.Reference.props" />
</Project>
