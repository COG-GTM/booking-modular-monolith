<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PackageId>BookingModularMonolith.$(MSBuildProjectName)</PackageId>
    <Authors>Booking Modular Monolith contributors</Authors>
    <Description>Focused shared infrastructure for Booking Modular Monolith.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
