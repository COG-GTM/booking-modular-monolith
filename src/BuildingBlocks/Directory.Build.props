<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Shared packaging metadata so every BuildingBlocks library can be packed for the local NuGet feed with SemVer. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>booking-modular-monolith</Authors>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
