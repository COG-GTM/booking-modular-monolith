<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared packaging metadata for the BuildingBlocks.* libraries (local NuGet feed, SemVer). -->
  <PropertyGroup>
    <BuildingBlocksVersion>1.1.0</BuildingBlocksVersion>
    <VersionPrefix>$(BuildingBlocksVersion)</VersionPrefix>
    <RootNamespace>BuildingBlocks</RootNamespace>
    <PackageId>BookingModularMonolith.$(MSBuildProjectName)</PackageId>
    <Authors>booking-modular-monolith</Authors>
    <Company>booking-modular-monolith</Company>
    <PackageTags>booking-modular-monolith;building-blocks</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
