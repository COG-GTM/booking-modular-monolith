<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Contracts.Messages</AssemblyName>
    <RootNamespace>BuildingBlocks.Contracts.EventBus.Messages</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>BookingModularMonolith.Contracts.Messages</PackageId>
    <Version>1.0.0</Version>
    <Authors>COG-GTM</Authors>
    <Description>Integration-event contracts shared between the booking services (Identity, Flight, Passenger, Booking). Additive changes only; breaking changes ship as new versioned message types.</Description>
    <PackageTags>booking;contracts;integration-events;masstransit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.Abstractions" Version="8.5.8" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
