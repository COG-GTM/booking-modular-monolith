<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="Versions.props" Condition="'$(ContractsVersionsImported)' != 'true'" />

  <!-- Shared packaging metadata for the versioned contract packages (local NuGet feed, SemVer). -->
  <PropertyGroup>
    <VersionPrefix>$(ContractsMessagesVersion)</VersionPrefix>
    <PackageId>BookingModularMonolith.$(MSBuildProjectName)</PackageId>
    <Authors>booking-modular-monolith</Authors>
    <Company>booking-modular-monolith</Company>
    <PackageTags>booking-modular-monolith;contracts;integration-events</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
