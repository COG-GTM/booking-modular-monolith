<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Contracts.Messages</PackageId>
    <Version>1.0.0</Version>
    <Authors>booking-modular-monolith</Authors>
    <Description>Shared integration-event contracts for the booking modules. Versioned with SemVer; additive changes only, breaking changes require a new message version (V2, V3, ...).</Description>
    <PackageTags>contracts;integration-events;eventbus</PackageTags>
    <RepositoryUrl>https://github.com/COG-GTM/booking-modular-monolith</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.Abstractions" Version="8.5.8" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>
</Project>
