{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Information"
        }
    },
    "Jwt": {
        "Authority": "https://identity-api:5001",
        "Audience": "booking-modular-monolith"
    },
    "ReverseProxy": {
        "Routes": {
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/v1/identity/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/api/v1/identity" }
                ]
            },
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/v1/flight/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/api/v1/flight" }
                ]
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/v1/passenger/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/api/v1/passenger" }
                ]
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/v1/booking/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/api/v1/booking" }
                ]
            }
        },
        "Clusters": {
            "identity-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://identity-api:8080"
                    }
                }
            },
            "flight-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://flight-api:8080"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://passenger-api:8080"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "http://booking-api:8080"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
