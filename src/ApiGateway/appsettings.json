{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "flight-route": {
        "ClusterId": "flight-cluster",
        "Match": {
          "Path": "/api/v1/flight/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "passenger-route": {
        "ClusterId": "passenger-cluster",
        "Match": {
          "Path": "/api/v1/passenger/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/booking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "flight-cluster": {
        "Destinations": {
          "flight-api": {
            "Address": "https+http://flight-api"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https+http://identity-api"
          }
        }
      },
      "passenger-cluster": {
        "Destinations": {
          "passenger-api": {
            "Address": "https+http://passenger-api"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-api": {
            "Address": "https+http://booking-api"
          }
        }
      }
    }
  }
}
