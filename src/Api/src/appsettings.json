{
    "AppOptions": {
        "Name": "Booking-Modular-Monolith"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "PostgresOptions": {
        "ConnectionString": {
            "Flight": "Server=localhost;Port=5432;Database=flight_service;User Id=flight_service;Password=flight_service;Include Error Detail=true",
            "Identity": "Server=localhost;Port=5432;Database=identity_service;User Id=identity_service;Password=identity_service;Include Error Detail=true",
            "Passenger": "Server=localhost;Port=5432;Database=passenger_service;User Id=passenger_service;Password=passenger_service;Include Error Detail=true"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://localhost:27017",
        "Flight": {
            "DatabaseName": "flight_service_read"
        },
        "Passenger": {
            "DatabaseName": "passenger_service_read"
        },
        "Booking": {
            "DatabaseName": "booking_service_read"
        }
    },
    "EventStoreOptions": {
        "ConnectionString": "esdb://localhost:2113?tls=false"
    },
    "Jwt": {
        "Authority": "https://localhost:3000",
        "Audience": "booking-modular-monolith"
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": {
            "Flight": "Server=localhost;Port=5432;Database=flight_service_persist_message;User Id=flight_service;Password=flight_service;Include Error Detail=true",
            "Identity": "Server=localhost;Port=5432;Database=identity_service_persist_message;User Id=identity_service;Password=identity_service;Include Error Detail=true",
            "Passenger": "Server=localhost;Port=5432;Database=passenger_service_persist_message;User Id=passenger_service;Password=passenger_service;Include Error Detail=true",
            "Booking": "Server=localhost;Port=5432;Database=booking_service_persist_message;User Id=booking_service;Password=booking_service;Include Error Detail=true"
        }
    },
    "RabbitMqOptions": {
        "HostName": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UserName": "guest",
        "Password": "guest"
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_modular_monolith_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Booking Modular Monolith Service"
    },
    "AllowedHosts": "*",
    "Modules": {
        "Flight": {
            "BackgroundProcessingEnabled": true
        },
        "Identity": {
            "BackgroundProcessingEnabled": true
        },
        "Passenger": {
            "BackgroundProcessingEnabled": true
        },
        "Booking": {
            "BackgroundProcessingEnabled": true
        }
    }
}
