{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "identity": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "flight": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "passenger": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "booking": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}
