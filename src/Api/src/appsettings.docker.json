{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:80"
            },
            "Grpc": {
                "Url": "http://+:81",
                "Protocols": "Http2"
            }
        }
    },
    "Grpc": {
        "FlightAddress": "http://localhost:81",
        "PassengerAddress": "http://localhost:81"
    },
    "MessageBroker": {
        "TransportType": "RabbitMq",
        "RabbitMq": {
            "Host": "rabbitmq"
        }
    }
}
