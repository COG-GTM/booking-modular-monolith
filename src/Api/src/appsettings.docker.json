{
    "ReverseProxy": {
        "Routes": {
            "flight-api": {
                "ClusterId": "flight",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-api": {
                "ClusterId": "passenger",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "booking-api": {
                "ClusterId": "booking",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            },
            "identity-api": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "identity-connect": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "identity-discovery": {
                "ClusterId": "identity",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "identity": {
                "Destinations": {
                    "default": {
                        "Address": "http://identity-api"
                    }
                }
            },
            "flight": {
                "Destinations": {
                    "default": {
                        "Address": "http://flight-api"
                    }
                }
            },
            "passenger": {
                "Destinations": {
                    "default": {
                        "Address": "http://passenger-api"
                    }
                }
            },
            "booking": {
                "Destinations": {
                    "default": {
                        "Address": "http://booking-api"
                    }
                }
            }
        }
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_gateway",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": false,
        "UseGrafanaExporter": false,
        "ServiceName": "Booking Gateway"
    }
}
