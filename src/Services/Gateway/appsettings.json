{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Yarp.ReverseProxy": "Information"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5000"
            }
        }
    },
    "ReverseProxy": {
        "Routes": {
            "flight-api": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-api": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "identity-api": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "identity-discovery": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            },
            "identity-protocol": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "booking-api": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "flight-cluster": {
                "Destinations": {
                    "flight-service": {
                        "Address": "http://localhost:5101"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "passenger-service": {
                        "Address": "http://localhost:5102"
                    }
                }
            },
            "identity-cluster": {
                "Destinations": {
                    "identity-service": {
                        "Address": "http://localhost:5103"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "booking-service": {
                        "Address": "http://localhost:5104"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
