{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Yarp": "Information"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "identity-connect-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "identity-wellknown-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "flight-cluster": {
                "Destinations": {
                    "flight-destination": {
                        "Address": "https://localhost:7001"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "passenger-destination": {
                        "Address": "https://localhost:7002"
                    }
                }
            },
            "identity-cluster": {
                "Destinations": {
                    "identity-destination": {
                        "Address": "https://localhost:7003"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "booking-destination": {
                        "Address": "https://localhost:7004"
                    }
                }
            }
        }
    }
}
