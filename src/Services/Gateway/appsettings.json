{
    "AppOptions": {
        "Name": "Booking-Gateway"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Yarp": "Debug"
        }
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ReverseProxy": {
        "Routes": {
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/v1/flight/{**remainder}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/v1/flight/{**remainder}"
                    }
                ]
            },
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/v1/identity/{**remainder}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/v1/identity/{**remainder}"
                    }
                ]
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/v1/passenger/{**remainder}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/v1/passenger/{**remainder}"
                    }
                ]
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/v1/booking/{**remainder}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/v1/booking/{**remainder}"
                    }
                ]
            },
            "openapi-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/scalar/{**remainder}"
                }
            },
            "connect-token-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/connect/{**remainder}"
                }
            }
        },
        "Clusters": {
            "flight-cluster": {
                "Destinations": {
                    "flight-api": {
                        "Address": "https+http://flight-api"
                    }
                }
            },
            "identity-cluster": {
                "Destinations": {
                    "identity-api": {
                        "Address": "https+http://identity-api"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "passenger-api": {
                        "Address": "https+http://passenger-api"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "booking-api": {
                        "Address": "https+http://booking-api"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
