{
    "AppOptions": {
        "Name": "Gateway"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Information"
        }
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "gateway",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Gateway"
    },
    "ReverseProxy": {
        "Routes": {
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            },
            "identity-connect-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "identity-discovery-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "identity-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "https://localhost:5001"
                    }
                }
            },
            "flight-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "https://localhost:5002"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "https://localhost:5003"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "https://localhost:5004"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
