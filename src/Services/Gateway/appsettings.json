{
    "AppOptions": {
        "Name": "Gateway"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "ReverseProxy": {
        "Routes": {
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/v1/flight/{**catch-all}"
                }
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/v1/booking/{**catch-all}"
                }
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/v1/passenger/{**catch-all}"
                }
            },
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/identity/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "flight-cluster": {
                "Destinations": {
                    "flight-api": {
                        "Address": "https+http://flight-api"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "booking-api": {
                        "Address": "https+http://booking-api"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "passenger-api": {
                        "Address": "https+http://passenger-api"
                    }
                }
            },
            "identity-cluster": {
                "Destinations": {
                    "identity-api": {
                        "Address": "https+http://identity-api"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
