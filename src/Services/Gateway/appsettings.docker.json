{
    "AppOptions": {
        "Name": "Gateway"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Yarp": "Information"
        }
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "gateway",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://aspire-dashboard:18889"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Gateway"
    },
    "ReverseProxy": {
        "Routes": {
            "identity-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/api/{version}/identity/{**catch-all}"
                }
            },
            "flight-route": {
                "ClusterId": "flight-cluster",
                "Match": {
                    "Path": "/api/{version}/flight/{**catch-all}"
                }
            },
            "passenger-route": {
                "ClusterId": "passenger-cluster",
                "Match": {
                    "Path": "/api/{version}/passenger/{**catch-all}"
                }
            },
            "booking-route": {
                "ClusterId": "booking-cluster",
                "Match": {
                    "Path": "/api/{version}/booking/{**catch-all}"
                }
            },
            "identity-connect-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/connect/{**catch-all}"
                }
            },
            "identity-discovery-route": {
                "ClusterId": "identity-cluster",
                "Match": {
                    "Path": "/.well-known/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "identity-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "http://identity-api"
                    }
                }
            },
            "flight-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "http://flight-api"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "http://passenger-api"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "primary": {
                        "Address": "http://booking-api"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}
