{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:5000"
            }
        }
    },
    "ReverseProxy": {
        "Clusters": {
            "flight-cluster": {
                "Destinations": {
                    "flight-service": {
                        "Address": "http://flight-service:5101"
                    }
                }
            },
            "passenger-cluster": {
                "Destinations": {
                    "passenger-service": {
                        "Address": "http://passenger-service:5102"
                    }
                }
            },
            "identity-cluster": {
                "Destinations": {
                    "identity-service": {
                        "Address": "http://identity-service:5103"
                    }
                }
            },
            "booking-cluster": {
                "Destinations": {
                    "booking-service": {
                        "Address": "http://booking-service:5104"
                    }
                }
            }
        }
    }
}
