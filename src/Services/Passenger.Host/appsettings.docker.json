{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Passenger": "Server=postgres;Port=5432;Database=passenger_service;User Id=passenger_service;Password=passenger_service;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "ConnectionString": {
      "Passenger": "Server=postgres;Port=5432;Database=passenger_service_persist_message;User Id=passenger_service;Password=passenger_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "Passenger": {
      "ConnectionString": "mongodb://mongo:27017"
    }
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq"
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "MetadataAddress": "http://booking_modular_monolith/.well-known/openid-configuration"
  }
}
