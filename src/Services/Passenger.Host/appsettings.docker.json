{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:80"
      },
      "Grpc": {
        "Url": "http://+:81",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Passenger": "Server=postgres;Port=5432;Database=passenger_service;User Id=passenger_service;Password=passenger_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://mongo:27017"
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq"
  },
  "Jwt": {
    "MetadataAddress": "http://booking_modular_monolith:80/.well-known/openid-configuration"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317",
      "OTLPHttpExporterEndpoint": "http://otel-collector:4318"
    },
    "UseAspireOTLPExporter": false
  }
}
