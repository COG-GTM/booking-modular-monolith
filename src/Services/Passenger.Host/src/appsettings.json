{
    "AppOptions": {
        "Name": "Passenger-Service"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5300",
                "Protocols": "Http1AndHttp2"
            },
            "Grpc": {
                "Url": "http://localhost:5301",
                "Protocols": "Http2"
            }
        }
    },
    "PostgresOptions": {
        "ConnectionString": {
            "Passenger": "Server=localhost;Port=5432;Database=passenger_service;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": {
            "Passenger": "Server=localhost;Port=5432;Database=passenger_service_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://localhost:27017",
        "Passenger": {
            "DatabaseName": "passenger_service_read"
        }
    },
    "AuthOptions": {
        "IssuerUri": "https://localhost:3000"
    },
    "Jwt": {
        "Authority": "https://localhost:3000",
        "Audience": "booking-modular-monolith"
    },
    "MessageBroker": {
        "TransportType": "RabbitMq",
        "ServiceName": "passenger",
        "UseInbox": true,
        "RabbitMq": {
            "Host": "localhost",
            "Port": 5672,
            "VirtualHost": "/",
            "Username": "guest",
            "Password": "guest"
        }
    },
    "Modules": {
        "Passenger": {
            "BackgroundProcessingEnabled": true
        }
    },
    "HealthOptions": {
        "Enabled": false,
        "DependencyChecksEnabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "passenger_service",
        "OTLPOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "passenger-service"
    },
    "AllowedHosts": "*"
}
