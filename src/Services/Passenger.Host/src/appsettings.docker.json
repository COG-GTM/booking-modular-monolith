{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:80",
                "Protocols": "Http1AndHttp2"
            },
            "Grpc": {
                "Url": "http://+:81",
                "Protocols": "Http2"
            }
        }
    },
    "PostgresOptions": {
        "ConnectionString": {
            "Passenger": "Server=postgres;Port=5432;Database=passenger_service;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://mongo:27017",
        "Passenger": {
            "DatabaseName": "passenger_service_read"
        }
    },
    "MessageBroker": {
        "RabbitMq": {
            "Host": "rabbitmq"
        }
    },
    "ObservabilityOptions": {
        "InstrumentationName": "passenger_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://aspire-dashboard:18889"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Passenger Service"
    },
    "PersistMessageOptions": {
        "ConnectionString": {
            "Passenger": "Server=postgres;Port=5432;Database=passenger_service_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    }
}
