{
  "AppOptions": {
    "Name": "Passenger-Service"
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Passenger": "Server=localhost;Port=5432;Database=passenger_service;User Id=passenger_service;Password=passenger_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "Passenger": {
      "DatabaseName": "passenger_service_read"
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "Audience": "booking-modular-monolith",
    "MetadataAddress": "http://localhost:3001/.well-known/openid-configuration"
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true
  },
  "MessagingOptions": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "booking",
    "Password": "booking"
  },
  "HealthOptions": {
    "Enabled": false
  },
  "ObservabilityOptions": {
    "InstrumentationName": "passenger_service",
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false,
    "ServiceName": "passenger-service"
  },
  "AllowedHosts": "*",
  "Modules": {
    "Passenger": {
      "BackgroundProcessingEnabled": true
    }
  }
}
