{
    "AppOptions": {
        "Name": "Passenger-Service"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5102",
                "Protocols": "Http1"
            },
            "Grpc": {
                "Url": "http://localhost:5202",
                "Protocols": "Http2"
            }
        }
    },
    "PostgresOptions": {
        "ConnectionString": {
            "Passenger": "Server=localhost;Port=5432;Database=passenger_modular_monolith;User Id=passenger;Password=passenger;Include Error Detail=true"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://localhost:27017",
        "Passenger": {
            "DatabaseName": "passenger_modular_monolith_read"
        }
    },
    "MessageBroker": {
        "TransportType": "RabbitMq",
        "ServiceName": "passenger"
    },
    "RabbitMqOptions": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest"
    },
    "Jwt": {
        "Authority": "https://localhost:3000",
        "Audience": "booking-modular-monolith"
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "passenger_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Passenger Service"
    },
    "AllowedHosts": "*"
}
