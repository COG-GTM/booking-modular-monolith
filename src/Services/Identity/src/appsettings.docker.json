{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:80"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=postgres;Port=5432;Database=identity_modular_monolith;User Id=identity;Password=identity;Include Error Detail=true"
    }
  },
  "MessageBroker": {
    "TransportType": "RabbitMq",
    "ServiceName": "identity"
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "booking"
  },
  "Jwt": {
    "Authority": "http://identity-service",
    "Audience": "booking-modular-monolith"
  },
  "AuthOptions": {
    "IssuerUri": "http://identity-service"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
      "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
    }
  }
}
