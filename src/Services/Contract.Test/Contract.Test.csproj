<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Booking's consumer-side copy of the Flight contract, compiled here as a client stub and exercised against the real Flight host. -->
    <Protobuf Include="..\Booking.Api\src\GrpcClient\Protos\flight.proto" GrpcServices="Client" ProtoRoot="..\Booking.Api\src\GrpcClient\Protos" Link="Protos\booking-flight.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flight.Api\src\Flight.Api.csproj" />
    <ProjectReference Include="..\Passenger.Api\src\Passenger.Api.csproj" />
  </ItemGroup>

</Project>
