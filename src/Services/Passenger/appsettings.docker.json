{
    "Kestrel": {
        "EndpointDefaults": {
            "Protocols": "Http1AndHttp2"
        },
        "Endpoints": {
            "Http": {
                "Url": "http://+:5102"
            },
            "Grpc": {
                "Url": "http://+:5112",
                "Protocols": "Http2"
            }
        }
    },
    "RabbitMqOptions": {
        "HostName": "rabbitmq",
        "ExchangeName": "booking-modular-monolith",
        "UserName": "guest",
        "Password": "guest",
