{
    "PostgresOptions": {
        "ConnectionString": {
            "Identity": "Server=postgres;Port=5432;Database=identity_service;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "RabbitMqOptions": {
        "HostName": "rabbitmq",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "identity"
    },
    "Jwt": {
        "Authority": "http://identity-api",
        "Audience": "identity-api"
    },
    "AuthOptions": {
        "IssuerUri": "http://identity-api"
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": "Server=postgres;Port=5432;Database=identity_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
    },
    "ObservabilityOptions": {
        "InstrumentationName": "identity_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": false,
        "UseGrafanaExporter": false,
        "ServiceName": "Identity Service"
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:80",
                "Protocols": "Http1"
            }
        }
    }
}
