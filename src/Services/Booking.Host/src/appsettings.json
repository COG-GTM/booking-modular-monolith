{
    "AppOptions": {
        "Name": "Booking-Service"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://localhost:27017",
        "Booking": {
            "DatabaseName": "booking_service_read"
        }
    },
    "EventStoreOptions": {
        "ConnectionString": "esdb://localhost:2113?tls=false"
    },
    "AuthOptions": {
        "IssuerUri": "https://localhost:3000"
    },
    "Jwt": {
        "Authority": "https://localhost:3000",
        "Audience": "booking-modular-monolith"
    },
    "Grpc": {
        "FlightAddress": "http://localhost:5201",
        "PassengerAddress": "http://localhost:5301",
        "Deadline": "00:00:10",
        "MaxAttempts": 3
    },
    "MessageBroker": {
        "TransportType": "RabbitMq",
        "ServiceName": "booking-service",
        "UseInbox": true,
        "RabbitMq": {
            "Host": "localhost",
            "Port": 5672,
            "VirtualHost": "/",
            "Username": "guest",
            "Password": "guest"
        }
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": {
            "Booking": "Server=localhost;Port=5432;Database=booking_service_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "Modules": {
        "Booking": {
            "BackgroundProcessingEnabled": true
        }
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://localhost:14317",
            "HttpExporterEndpoint": "http://localhost:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Booking Service"
    },
    "AllowedHosts": "*"
}
