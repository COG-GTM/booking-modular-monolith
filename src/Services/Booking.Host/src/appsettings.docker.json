{
    "MongoOptions": {
        "ConnectionString": "mongodb://mongo:27017",
        "Booking": {
            "DatabaseName": "booking_service_read"
        }
    },
    "EventStoreOptions": {
        "ConnectionString": "esdb://eventstore:2113?tls=false"
    },
    "Jwt": {
        "Authority": "https://localhost:3000",
        "MetadataAddress": "http://identity-service/.well-known/openid-configuration"
    },
    "Grpc": {
        "FlightAddress": "http://flight-service:81",
        "PassengerAddress": "http://passenger-service:81"
    },
    "MessageBroker": {
        "RabbitMq": {
            "Host": "rabbitmq"
        }
    },
    "PersistMessageOptions": {
        "ConnectionString": {
            "Booking": "Server=postgres;Port=5432;Database=booking_service_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
        }
    },
    "ObservabilityOptions": {
        "OTLPOptions": {
            "OTLPGrpcExporterEndpoint": "http://otel-collector:4317"
        },
        "UseAspireOTLPExporter": false
    }
}
