{
  "AppOptions": {
    "Name": "Booking-Service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "ConnectionString": {
      "Booking": "Server=localhost;Port=5432;Database=booking_service_persist_message;User Id=booking_service;Password=booking_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "Booking": {
      "DatabaseName": "booking_service_read"
    }
  },
  "EventStoreOptions": {
    "ConnectionString": "esdb://localhost:2113?tls=false"
  },
  "Jwt": {
    "Authority": "http://localhost:5101",
    "MetadataAddress": "http://localhost:5101/.well-known/openid-configuration",
    "Audience": "booking-modular-monolith"
  },
  "Grpc": {
    "FlightAddress": "http://localhost:5112",
    "PassengerAddress": "http://localhost:5113"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "ObservabilityOptions": {
    "InstrumentationName": "booking_service",
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": false,
    "UseGrafanaExporter": false,
    "ServiceName": "booking-service"
  },
  "Modules": {
    "Booking": {
      "BackgroundProcessingEnabled": true
    }
  },
  "AllowedHosts": "*"
}
