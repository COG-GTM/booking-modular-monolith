{
  "AppOptions": {
    "Name": "Booking-Service"
  },
  "Grpc": {
    "Flight": {
      "Address": "http://_grpc.flight"
    },
    "Passenger": {
      "Address": "http://_grpc.passenger"
    }
  },
  "Services": {
    "flight": {
      "grpc": [ "http://localhost:3002" ]
    },
    "passenger": {
      "grpc": [ "http://localhost:3002" ]
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Booking": "Server=localhost;Port=5432;Database=booking_service;User Id=booking_service;Password=booking_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "Booking": {
      "DatabaseName": "booking_service_read"
    }
  },
  "EventStoreOptions": {
    "ConnectionString": "esdb://localhost:2113?tls=false"
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "Audience": "booking-modular-monolith",
    "MetadataAddress": "http://localhost:3001/.well-known/openid-configuration"
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true
  },
  "MessagingOptions": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "booking",
    "Password": "booking"
  },
  "HealthOptions": {
    "Enabled": false
  },
  "ObservabilityOptions": {
    "InstrumentationName": "booking_service",
    "OTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false,
    "ServiceName": "Booking Service"
  },
  "Modules": {
    "Booking": {
      "BackgroundProcessingEnabled": true,
      "SubscriptionId": "booking-service"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
