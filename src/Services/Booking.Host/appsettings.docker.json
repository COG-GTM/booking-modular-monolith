{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:80"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Booking": "Server=postgres;Port=5432;Database=booking_service;User Id=booking_service;Password=booking_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://mongo:27017",
    "Booking": {
      "DatabaseName": "booking_service_read"
    }
  },
  "EventStoreOptions": {
    "ConnectionString": "esdb://eventstore:2113?tls=false"
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq"
  },
  "Services": {
    "flight": {
      "grpc": [ "http://flight-service:81" ]
    },
    "passenger": {
      "grpc": [ "http://passenger-service:81" ]
    }
  },
  "Jwt": {
    "MetadataAddress": "http://identity-service:80/.well-known/openid-configuration"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317",
      "OTLPHttpExporterEndpoint": "http://otel-collector:4318"
    },
    "UseAspireOTLPExporter": false
  }
}
