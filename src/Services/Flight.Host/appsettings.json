{
  "AppOptions": {
    "Name": "Flight-Service"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5102",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://localhost:5106",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Flight": "Server=localhost;Port=5432;Database=flight_service;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "Flight": {
      "DatabaseName": "flight_service_read"
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "Audience": "booking-modular-monolith",
    "MetadataAddress": "http://localhost:3001/.well-known/openid-configuration"
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true
  },
  "MessagingOptions": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "booking",
    "Password": "booking"
  },
  "HealthOptions": {
    "Enabled": false
  },
  "ObservabilityOptions": {
    "InstrumentationName": "flight_service",
    "OTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false,
    "ServiceName": "Flight Service"
  },
  "AllowedHosts": "*",
  "Modules": {
    "Flight": {
      "BackgroundProcessingEnabled": true
    }
  }
}
