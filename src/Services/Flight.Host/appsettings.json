{
  "AppOptions": {
    "Name": "Flight Service"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5102",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://localhost:5112",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Flight": "Server=localhost;Port=5432;Database=flight_service;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true,
    "ConnectionString": {
      "Flight": "Server=localhost;Port=5432;Database=flight_service_persist_message;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "Flight": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "flight_service_read"
    }
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Authority": "http://localhost:5101",
    "Audience": "booking-modular-monolith",
    "MetadataAddress": "http://localhost:5101/.well-known/openid-configuration"
  },
  "ObservabilityOptions": {
    "InstrumentationName": "flight_service",
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false,
    "ServiceName": "flight-service"
  },
  "Modules": {
    "Flight": {
      "BackgroundProcessingEnabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
