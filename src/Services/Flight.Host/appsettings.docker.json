{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Flight": "Server=postgres;Port=5432;Database=flight_service;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "ConnectionString": {
      "Flight": "Server=postgres;Port=5432;Database=flight_service_persist_message;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://mongo:27017",
    "Flight": {
      "ConnectionString": "mongodb://mongo:27017",
      "DatabaseName": "flight_service_read"
    }
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "MetadataAddress": "http://identity-service:8080/.well-known/openid-configuration"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://lgtm:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://aspire-dashboard:18889"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://zipkin:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://jaeger:4317",
      "HttpExporterEndpoint": "http://jaeger:14268/api/traces"
    }
  }
}
