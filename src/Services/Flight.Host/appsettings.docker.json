{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:80",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://+:81",
        "Protocols": "Http2"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Flight": "Server=postgres;Port=5432;Database=flight_service;User Id=flight_service;Password=flight_service;Include Error Detail=true"
    }
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://mongo:27017",
    "Flight": {
      "DatabaseName": "flight_service_read"
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "Audience": "booking-modular-monolith",
    "MetadataAddress": "http://identity-service:80/.well-known/openid-configuration"
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "booking",
    "Password": "booking"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317"
    },
    "UseAspireOTLPExporter": false
  }
}
