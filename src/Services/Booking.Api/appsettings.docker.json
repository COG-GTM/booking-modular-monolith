{
    "AppOptions": {
        "Name": "Booking-Api"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "MongoOptions": {
        "ConnectionString": "mongodb://mongo:27017",
        "DatabaseName": "booking-read-db"
    },
    "EventStoreOptions": {
        "ConnectionString": "esdb://eventstore:2113?tls=false"
    },
    "Grpc": {
        "FlightAddress": "http://flight-api:81",
        "PassengerAddress": "http://passenger-api:81"
    },
    "RabbitMqOptions": {
        "HostName": "rabbitmq",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "booking",
        "QueuePrefix": "booking-api"
    },
    "Jwt": {
        "Authority": "http://identity-api",
        "Audience": "booking-api"
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": "Server=postgres;Port=5432;Database=booking-outbox-db;User Id=postgres;Password=postgres;Include Error Detail=true"
    },
    "HealthOptions": {
        "Enabled": false
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_api",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://aspire-dashboard:18889"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": true,
        "UseGrafanaExporter": false,
        "ServiceName": "Booking Api"
    },
    "AllowedHosts": "*"
}
