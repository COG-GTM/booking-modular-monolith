{
    "MongoOptions": {
        "ConnectionString": "mongodb://mongo:27017"
    },
    "EventStoreOptions": {
        "ConnectionString": "esdb://eventstore:2113?tls=false"
    },
    "RabbitMqOptions": {
        "HostName": "rabbitmq",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "ExchangeName": "booking"
    },
    "Jwt": {
        "Authority": "http://identity-api",
        "Audience": "booking-api"
    },
    "Grpc": {
        "FlightAddress": "http://flight-api:81",
        "PassengerAddress": "http://passenger-api:81"
    },
    "PersistMessageOptions": {
        "Interval": 30,
        "Enabled": true,
        "ConnectionString": "Server=postgres;Port=5432;Database=booking_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
    },
    "ObservabilityOptions": {
        "InstrumentationName": "booking_service",
        "OTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://otel-collector:4317"
        },
        "AspireDashboardOTLPOptions": {
            "OTLPGrpExporterEndpoint": "http://localhost:4319"
        },
        "ZipkinOptions": {
            "HttpExporterEndpoint": "http://zipkin-all-in-one:9411/api/v2/spans"
        },
        "JaegerOptions": {
            "OTLPGrpcExporterEndpoint": "http://jaeger-all-in-one:4317",
            "HttpExporterEndpoint": "http://jaeger-all-in-one:14268/api/traces"
        },
        "UsePrometheusExporter": true,
        "UseOTLPExporter": true,
        "UseAspireOTLPExporter": false,
        "UseGrafanaExporter": false,
        "ServiceName": "Booking Service"
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:80",
                "Protocols": "Http1"
            }
        }
    }
}
