{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=postgres;Port=5432;Database=identity_service;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "ConnectionString": {
      "Identity": "Server=postgres;Port=5432;Database=identity_service_persist_message;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "AuthOptions": {
    "IssuerUri": "http://localhost:5000"
  },
  "Jwt": {
    "Authority": "http://localhost:5000",
    "MetadataAddress": "http://localhost:8080/.well-known/openid-configuration"
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq"
  },
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317"
    }
  }
