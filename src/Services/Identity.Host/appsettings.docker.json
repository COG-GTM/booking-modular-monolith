{
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=postgres;Port=5432;Database=identity_service;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "RabbitMqOptions": {
    "HostName": "rabbitmq"
  },
  "Jwt": {
    "Authority": "http://localhost",
    "MetadataAddress": "http://localhost/.well-known/openid-configuration"
  },
  "AuthOptions": {
    "IssuerUri": "http://localhost"
  },
  "Urls": "http://+:80",
  "ObservabilityOptions": {
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://otel-collector:4317",
      "OTLPHttpExporterEndpoint": "http://otel-collector:4318"
    },
    "UseAspireOTLPExporter": false
  }
}
