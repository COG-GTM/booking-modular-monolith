{
  "AppOptions": {
    "Name": "Identity-Service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5101"
      }
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=localhost;Port=5432;Database=identity_service;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true,
    "ConnectionString": {
      "Identity": "Server=localhost;Port=5432;Database=identity_service_persist_message;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "AuthOptions": {
    "IssuerUri": "http://localhost:5101"
  },
  "Jwt": {
    "Authority": "http://localhost:5101",
    "Audience": "booking-modular-monolith"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "ObservabilityOptions": {
    "InstrumentationName": "identity_service",
    "ServiceName": "identity-service",
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": false,
    "UseGrafanaExporter": false
  },
  "AllowedHosts": "*",
  "Modules": {
    "Identity": {
      "BackgroundProcessingEnabled": true
    }
  }
}
