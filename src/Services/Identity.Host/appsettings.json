{
  "AppOptions": {
    "Name": "Identity-Service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=localhost;Port=5432;Database=identity_service;User Id=identity_service;Password=identity_service;Include Error Detail=true"
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5103",
    "Audience": "booking-modular-monolith"
  },
  "AuthOptions": {
    "IssuerUri": "http://localhost:5103"
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true
  },
  "MessagingOptions": {
    "Transport": "RabbitMq"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "booking",
    "Password": "booking"
  },
  "HealthOptions": {
    "Enabled": true,
    "UIEnabled": false
  },
  "ObservabilityOptions": {
    "ServiceName": "identity-service",
    "InstrumentationName": "identity_service",
    "OTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4317",
      "OTLPHttpExporterEndpoint": "http://localhost:4318"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5103",
  "Modules": {
    "Identity": {
      "BackgroundProcessingEnabled": true
    }
  }
}
