{
  "AppOptions": {
    "Name": "Identity-Service"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "PostgresOptions": {
    "ConnectionString": {
      "Identity": "Server=localhost;Port=5432;Database=identity_service;User Id=postgres;Password=postgres;Include Error Detail=true"
    }
  },
  "PersistMessageOptions": {
    "Interval": 30,
    "Enabled": true,
    "ConnectionString": {
      "Identity": "Server=localhost;Port=5432;Database=identity_service_persist_message;User Id=postgres;Password=postgres;Include Error Detail=true"
    }
  },
  "AuthOptions": {
    "IssuerUri": "http://localhost:5100"
  },
  "Jwt": {
    "Authority": "http://localhost:5100",
    "Audience": "booking-modular-monolith"
  },
  "MessageBroker": {
    "TransportType": "RabbitMq",
    "ServiceName": "identity-service",
    "UseInbox": true,
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "HealthOptions": {
    "Enabled": false
  },
  "ObservabilityOptions": {
    "InstrumentationName": "identity_service",
    "OTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4317"
    },
    "AspireDashboardOTLPOptions": {
      "OTLPGrpExporterEndpoint": "http://localhost:4319"
    },
    "ZipkinOptions": {
      "HttpExporterEndpoint": "http://localhost:9411/api/v2/spans"
    },
    "JaegerOptions": {
      "OTLPGrpcExporterEndpoint": "http://localhost:14317",
      "HttpExporterEndpoint": "http://localhost:14268/api/traces"
    },
    "UsePrometheusExporter": true,
    "UseOTLPExporter": true,
    "UseAspireOTLPExporter": true,
    "UseGrafanaExporter": false,
    "ServiceName": "Identity Service"
  },
  "AllowedHosts": "*"
}
