    {
      "id": 12,
      "type": "timeseries",
      "title": "Kestrel connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
