    {
      "id": 13,
      "type": "logs",
      "title": "Logs ($service)",
      "datasource": {
        "type": "loki",
        "uid": "loki-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
