            "uid": "prometheus-uid"
          },
          "expr": "sum(process_memory_usage_bytes{job=\"$service\"})",
          "legendFormat": "process memory"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Thread pool / GC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
