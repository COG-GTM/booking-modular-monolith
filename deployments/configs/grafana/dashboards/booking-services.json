{
  "uid": "booking-services",
  "title": "Booking services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": [
    "booking",
    "observability"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-uid"
        },
        "query": {
          "query": "label_values(service_name)",
          "refId": "service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "metrics_job",
        "label": "Metrics source (avoid double counting)",
        "type": "custom",
        "query": "otel-collector,booking-services-direct,booking-services-local",
        "current": {
          "text": "otel-collector",
          "value": "otel-collector"
        },
        "options": [
          {
            "text": "otel-collector",
            "value": "otel-collector",
            "selected": true
          },
          {
            "text": "booking-services-direct",
            "value": "booking-services-direct"
          },
          {
            "text": "booking-services-local",
            "value": "booking-services-local"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",job=~\"$metrics_job\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",job=~\"$metrics_job\",http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",job=~\"$metrics_job\"}[5m])))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "gRPC client calls (when instrumented)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(rpc_client_duration_milliseconds_count{service_name=~\"$service\",job=~\"$metrics_job\"}[5m])) or sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_CLIENT\",rpc_system=\"grpc\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "gRPC server calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(grpc_server_call_duration_seconds_count{service_name=~\"$service\",job=~\"$metrics_job\"}[5m])) or sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",rpc_system=\"grpc\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "MassTransit publish (send) / consume (when emitted)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, __name__) (rate({__name__=~\"messaging_masstransit_(send|consume)_total\",service_name=~\"$service\",job=~\"$metrics_job\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Process CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(process_cpu_time_seconds_total{service_name=~\"$service\",job=~\"$metrics_job\"}[5m]))",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-uid"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (process_memory_usage_bytes{service_name=~\"$service\",job=~\"$metrics_job\"})",
          "legendFormat": "{{service_name}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 10,
      "title": "Service traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo-uid"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"$service\" }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "options": {}
    }
  ]
}
