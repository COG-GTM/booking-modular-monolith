# Copy to `deployments/docker-compose/.env` (git-ignored) and replace every value before `docker compose up`.
# Use long random alphanumeric values, e.g. `openssl rand -hex 24`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
